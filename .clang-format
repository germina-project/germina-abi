BasedOnStyle: LLVM
Language: Cpp
Standard: Latest

IndentWidth: 4
TabWidth: 4
UseTab: Never

ColumnLimit: 160

BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: false
  AfterControlStatement: Never
  AfterFunction: false
  AfterNamespace: false

SpacesInParentheses: false
SpacesInSquareBrackets: false
SpaceBeforeParens: ControlStatements

AlignEscapedNewlines: Left

SortIncludes: CaseSensitive

IncludeCategories:
  # 1. Заголовки вашей библиотеки (germina/...)
  - Regex:    '^<germina/.*'
    Priority: 2
  # 2. Стандартная библиотека C++ (угловые скобки без точек в расширениях, например <vector>, <iostream>)
  # А также стандартные C-хидеры (например, <cstddef>, <string.h>)
  - Regex:    '^<(vector|string|memory|map|set|unordered_.*|list|array|algorithm|functional|utility|chrono|initializer_list|cstd.*|std.*)>'
    Priority: 1
  - Regex:    '^<[^.]*>'
    Priority: 1
  # 3. Сторонние библиотеки (все остальные угловые скобки, например <boost/...>, <fmt/...>)
  - Regex:    '^<.*'
    Priority: 3
  # 4. Случайные / локальные инклуды (все остальные кавычки: "shared/file.h" и т.д.)
  - Regex:    '^".*'
    Priority: 4