#ifndef GERMINA_ABI_VERSION_H
#define GERMINA_ABI_VERSION_H

#include <stdint.h>

#define GERMINA_ABI_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define GERMINA_ABI_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define GERMINA_ABI_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define GERMINA_ABI_VERSION_REVISION 0x@GERMINA_ABI_GIT_HASH@U

typedef struct GAbiVersion {
    uint32_t major;
    uint32_t minor;
    uint32_t patch;
    uint32_t revision;
} GAbiVersion;

#endif